# Server Configuration
PORT=3000

# Cloudflare R2 Object Storage
# S3-compatible credentials created in Cloudflare Dashboard -> R2 -> Manage R2 API Tokens
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=fileconverter-temp

# -----------------------------------------------------------------------------
# Configurable File Retention & Automatic Deletion Policy
# -----------------------------------------------------------------------------
# Successfully converted output retention (in minutes, default: 60)
OUTPUT_RETENTION_MINUTES=60

# Failed or abandoned job retention (in minutes, default: 15)
FAILED_JOB_RETENTION_MINUTES=15

# Periodic background cleanup sweep interval (in minutes, default: 10)
CLEANUP_INTERVAL_MINUTES=10

# Orphaned R2 objects retention threshold before deletion (in hours, default: 24)
ORPHAN_CLEANUP_HOURS=24

# Stale local temporary directory file retention (in minutes, default: 15)
LOCAL_TEMP_RETENTION_MINUTES=15

# Cleanup batch query size (default: 50)
CLEANUP_BATCH_SIZE=50

# Optional secret token to authenticate on-demand POST /api/admin/cleanup calls from external schedulers
CLEANUP_ADMIN_SECRET=your_random_admin_cleanup_secret_here

# -----------------------------------------------------------------------------
# Optional Database & AI Integrations
# -----------------------------------------------------------------------------
# Cloudflare D1 Persistent Job Metadata Store (OPTIONAL: Native SQLite jobs.sqlite is used by default)
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
D1_DATABASE_ID=your_d1_database_uuid
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_with_d1_edit_permissions

# AI Integration (Optional: only needed for AI Summarizer & PDF Translator)
GEMINI_API_KEY=your_gemini_api_key_here

# -----------------------------------------------------------------------------
# Contact Form Gmail SMTP Notification Configuration
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_business_email@gmail.com
SMTP_PASS=replace_with_gmail_app_password
CONTACT_TO=pdfconverterfreebusiness@gmail.com

