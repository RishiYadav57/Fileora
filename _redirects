# Netlify Clean URL & 404 Redirect Rules for Fileora
/about            /about.html            200
/faq              /faq.html              200
/contact          /contact.html          200
/privacy-policy   /privacy-policy.html   200
/privacy          /privacy-policy        301!
/terms            /terms.html            200
/cookie-policy    /cookie-policy.html    200
/disclaimer       /disclaimer.html       200
/file-retention   /file-retention.html   200
/security         /file-retention        301!
/troubleshooting  /troubleshooting.html  200
/download         /download.html         200
/sitemap.xml      /sitemap.xml           200
/robots.txt       /robots.txt            200

# Canonical Tool Routes (rewrite to index.html for client routing)
/tools            /index.html            200
/tools/*          /index.html            200

# Legacy /tool/:slug redirects to canonical /tools/:slug
/tool/:slug       /tools/:slug           301!

