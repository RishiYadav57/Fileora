# Redirect rules for FileCorner (Cloudflare Pages syntax; also valid on Netlify).
# Pages serves /about from about.html, /download from download.html, /tools/<slug> from tools/<slug>.html (generated by
# scripts/build-public.js) and 404.html for unknown URLs, so none of those need rules here. Only redirects are listed.
/privacy          /privacy-policy        301
/security         /file-retention        301

# /tools has no page of its own: send it to the tool list on the home page
/tools            /#all-tools            301

# Legacy /tool/:slug redirects to canonical /tools/:slug
/tool/:slug       /tools/:slug           301

# Aliases in /tools/
/tools/pdf-to-ppt     /tools/pdf-to-powerpoint  301
/tools/ppt-to-pdf     /tools/powerpoint-to-pdf  301
/tools/ppt-to-word    /tools/powerpoint-to-word 301
/tools/word-to-ppt    /tools/word-to-powerpoint 301
/tools/rotate-pdf     /tools/organize-pdf       301
/tools/xlsm-to-pdf    /tools/excel-to-pdf       301
/tools/pdf-to-xlsm    /tools/pdf-to-excel       301

