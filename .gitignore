# Allow-list: nothing is committed unless it is listed below.
*
!.gitignore
!.dockerignore
!.env.example
!/dockerfile.txt
!/netlify.toml
!/_redirects
!/package.json
!/package-lock.json
!/requirements.txt
!/robots.txt
!/sitemap.xml
!/*.html
!/server.js
!/security.js
!/storage.js
!/mailer.js
!/jobgate.js
!/complexity.js
!/output_verify.py
!/converter-engine.js
!/seo-data.js
!/seo-render.js
!/tools_converter.py
!/assets/
!/assets/**
!/tessdata/
!/tessdata/*.traineddata
!/scripts/
!/scripts/build-public.js
!/worker/
!/worker/worker.mjs
!/worker/wrangler.toml
!/migrations/
!/migrations/*.sql
# never, even inside allowed folders
.env
*.pdf
*.log
*.sqlite
node_modules/
